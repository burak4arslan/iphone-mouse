# Copy this file to Config/local.env (ignored by git) and fill it in.
# Apple Developer Team ID: Xcode > Settings > Accounts > your account > Team (10 characters). A free Apple ID works too.
IPHONEFARE_TEAM_ID=ABCDE12345
# Bundle ID of the iPhone app (must be unique to you)
IPHONEFARE_BUNDLE_ID=com.yourname.iphonefare
# Bundle ID of the Mac app (used by Mac/build.sh)
IPHONEFARE_MAC_BUNDLE_ID=com.yourname.iphonefare.mac
